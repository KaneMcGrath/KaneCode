<UserControl x:Class="KaneCode.Controls.TicketPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KaneCode.Models">
    <DockPanel Background="{DynamicResource PanelBackground}">

        <!-- Header: provider/model/mode on the left, status + Initialize on the right -->
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                Background="{DynamicResource AiChatHeaderBackground}"
                BorderBrush="{DynamicResource AiChatBorder}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Tickets" FontWeight="SemiBold" Foreground="{DynamicResource PanelForeground}" />
                    <TextBlock x:Name="HeaderInfoText"
                               Margin="0,3,0,0"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AiChatSecondaryForeground}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Margin="0,0,8,0"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AiChatSecondaryForeground}" />
                    <Button x:Name="InitializeButton"
                            Content="Initialize"
                            Click="InitializeButton_Click"
                            Height="22"
                            Padding="8,1"
                            FontSize="11"
                            Cursor="Hand"
                            Foreground="{DynamicResource PanelForeground}"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- New Ticket button pinned at the bottom -->
        <Border DockPanel.Dock="Bottom"
                Padding="8,6"
                Background="{DynamicResource AiChatHeaderBackground}"
                BorderBrush="{DynamicResource AiChatBorder}"
                BorderThickness="0,1,0,0">
            <Button x:Name="NewTicketButton"
                    Content="＋ New Ticket"
                    Click="NewTicketButton_Click"
                    Height="26"
                    FontSize="12"
                    Cursor="Hand"
                    Foreground="{DynamicResource PanelForeground}"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" />
        </Border>

        <!-- Ticket list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
            <ListBox x:Name="TicketList"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="TicketList_MouseDoubleClick"
                     ContextMenuOpening="TicketList_ContextMenuOpening">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TreeViewItemMouseOverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TreeViewItemSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedForeground}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:KaneCodeTicket}">
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status glyph -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusGlyph}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />

                            <!-- Title + detail lines -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource AiChatSecondaryForeground}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding ConfigurationSummary, Mode=OneWay}" />
                                    <Run Text="  ·  priority " />
                                    <Run Text="{Binding Priority, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource AiChatSecondaryForeground}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ActiveAgentDisplayName, StringFormat='agent: {0}', TargetNullValue=''}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveAgentDisplayName}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Status text right-aligned -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding StatusText, Mode=OneWay}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AiChatSecondaryForeground}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</UserControl>
