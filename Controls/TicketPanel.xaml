<UserControl x:Class="KaneCode.Controls.TicketPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KaneCode.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource PanelBackground}">

        <!-- Header: provider/model/mode on the left, status + Initialize on the right -->
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                Background="{DynamicResource AiChatHeaderBackground}"
                BorderBrush="{DynamicResource AiChatBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Tickets" FontWeight="SemiBold" Foreground="{DynamicResource PanelForeground}" />
                        <TextBlock x:Name="HeaderInfoText"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AiChatSecondaryForeground}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Margin="0,0,8,0"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AiChatSecondaryForeground}" />
                        <Button x:Name="InitializeButton"
                                Content="Initialize"
                                Click="InitializeButton_Click"
                                Height="22"
                                Padding="8,1"
                                FontSize="11"
                                Cursor="Hand"
                                Foreground="{DynamicResource PanelForeground}"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <!-- Last dispatch problem (e.g. no provider configured, worktree failure) -->
                <TextBlock x:Name="IssueText"
                           Margin="0,6,0,0"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource AiChatToolCallErrorForeground}" />
            </StackPanel>
        </Border>

        <!-- New Ticket button pinned at the bottom -->
        <Border DockPanel.Dock="Bottom"
                Padding="8,6"
                Background="{DynamicResource AiChatHeaderBackground}"
                BorderBrush="{DynamicResource AiChatBorder}"
                BorderThickness="0,1,0,0">
            <Button x:Name="NewTicketButton"
                    Content="＋ New Ticket"
                    Click="NewTicketButton_Click"
                    Height="26"
                    FontSize="12"
                    Cursor="Hand"
                    Foreground="{DynamicResource PanelForeground}"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" />
        </Border>

        <!-- Ticket list (with an empty-state hint layered over it) -->
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
            <ListBox x:Name="TicketList"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="TicketList_MouseDoubleClick"
                     ContextMenuOpening="TicketList_ContextMenuOpening">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TreeViewItemMouseOverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TreeViewItemSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedForeground}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:KaneCodeTicket}">
                        <StackPanel Margin="0,1">

                            <!-- Header row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Status glyph -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StatusGlyph}"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />

                                <!-- Title + detail lines -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource AiChatSecondaryForeground}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding ConfigurationSummary, Mode=OneWay}" />
                                        <Run Text="  ·  priority " />
                                        <Run Text="{Binding Priority, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource AiChatSecondaryForeground}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding ActiveAgentDisplayName, StringFormat='agent: {0}', TargetNullValue=''}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveAgentDisplayName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Status text right-aligned -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusText, Mode=OneWay}"
                                           FontSize="10"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AiChatSecondaryForeground}" />

                                <!-- Expand/collapse the worktree changes section -->
                                <Button Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Click="ChangesToggle_Click"
                                        ToolTip="Show the agent's worktree changes"
                                        Foreground="{DynamicResource PanelForeground}"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}"
                                        BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="▸"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PanelForeground}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangesExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="▾"
                                                   Visibility="Collapsed"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PanelForeground}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangesExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Collapsible worktree changes section (fixed height) -->
                            <Border Margin="0,4,0,2"
                                    Padding="6"
                                    CornerRadius="4"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}"
                                    BorderThickness="1"
                                    Visibility="{Binding ChangesExpanded, Converter={StaticResource BoolToVis}}">
                                <Grid Height="150">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Margin="2,0,0,4"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AiChatSecondaryForeground}"
                                               Text="{Binding WorktreeChangesStatusText}" />

                                    <ListBox Grid.Row="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding WorktreeChanges}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="Margin" Value="0,1" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TreeViewItemMouseOverBackground}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TicketWorktreeChange}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding KindGlyph}"
                                                               Width="16"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource AiChatSecondaryForeground}" />
                                                    <TextBlock Text="{Binding RelativePath}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                        <Button Content="Merge to Workspace"
                                                Click="MergeWorktreeChanges_Click"
                                                Height="24"
                                                Padding="8,1"
                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Cursor="Hand"
                                                ToolTip="Apply all worktree changes to the main workspace without committing"
                                                Foreground="{DynamicResource PanelForeground}"
                                                Background="{DynamicResource ControlBackground}"
                                                BorderBrush="{DynamicResource ControlBorder}"
                                                BorderThickness="1" />
                                        <Button Content="Commit…"
                                                Click="CommitWorktreeChanges_Click"
                                                Height="24"
                                                Padding="8,1"
                                                FontSize="11"
                                                Cursor="Hand"
                                                ToolTip="Apply all worktree changes and commit them with a message"
                                                Foreground="{DynamicResource PanelForeground}"
                                                Background="{DynamicResource ControlBackground}"
                                                BorderBrush="{DynamicResource ControlBorder}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

            <TextBlock x:Name="EmptyStateText"
                       Margin="16,20,16,16"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource AiChatSecondaryForeground}" />
        </Grid>
    </DockPanel>
</UserControl>
