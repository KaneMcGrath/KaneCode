<Window x:Class="KaneCode.Controls.AiPresetEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KaneCode.Controls"
        Title="Preset Editor"
        Width="1240"
        Height="920"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Flat, theme-driven visual tokens for the preset editor.
             Every brush resolves through the MLib theme (DarkBrushes/LightBrushes),
             so the window follows the app's light/dark switch automatically. -->

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DiagnosticInfoForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PanelHeaderForeground}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0,0,0,3" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>

        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Static.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource ABrush.Foreground.Static}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ PRESET HEADER ═══════════════ -->
        <Grid Grid.Row="0" Margin="16,10,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 1: selector + actions -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Preset" FontSize="12"
                           Foreground="{DynamicResource PanelHeaderForeground}" VerticalAlignment="Center" Margin="0,0,8,0" />

                <ComboBox Grid.Column="1" x:Name="PresetSelector"
                          DisplayMemberPath="Name" MinHeight="24" FontSize="12"
                          VerticalContentAlignment="Center"
                          SelectionChanged="PresetSelector_SelectionChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="NewPresetButton" Content="New" MinWidth="52"
                            Margin="0,0,4,0" Padding="10,4" Click="NewPresetButton_Click" />
                    <Button x:Name="CopyFromToggleButton" Content="Copy From" MinWidth="82"
                            Margin="0,0,4,0" Padding="10,4" Click="CopyFromToggleButton_Click" />
                    <Button x:Name="DeletePresetButton" Content="Delete" MinWidth="56"
                            Padding="10,4" Click="DeletePresetButton_Click" />
                </StackPanel>

                <Popup x:Name="CopyFromPopup"
                       PlacementTarget="{Binding ElementName=CopyFromToggleButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Slide" Focusable="True" Closed="CopyFromPopup_Closed">
                    <Border Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            BorderThickness="1" Padding="0" MaxHeight="320" MinWidth="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CopyFromItemsPanel" />
                        </ScrollViewer>
                    </Border>
                </Popup>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="RevertButton" Content="Revert" MinWidth="64"
                            Margin="0,0,6,0" Padding="10,4" Click="RevertButton_Click" IsEnabled="False" />
                    <Button x:Name="SaveButton" Content="Save" MinWidth="72"
                            Margin="0,0,6,0" Padding="10,4" FontWeight="SemiBold"
                            Foreground="White"
                            Background="{DynamicResource ABrush.AccentTone2.Background.Static}"
                            BorderBrush="{DynamicResource ABrush.AccentTone2.Border.Static}"
                            Click="SaveButton_Click" IsEnabled="False" />
                    <Button Content="Cancel" MinWidth="64" Padding="10,4" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Row 2: name + hint -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontSize="12"
                           Foreground="{DynamicResource PanelHeaderForeground}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="PresetNameBox"
                         MinHeight="24" VerticalContentAlignment="Center"
                         Padding="6,3"
                         TextChanged="PresetNameBox_TextChanged" />
                <TextBlock Grid.Column="2" Text="Autosaves to ai-presets.json" FontSize="11"
                           Foreground="{DynamicResource ControlDisabledForeground}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Border Grid.Row="0" Height="1" Background="{DynamicResource ControlBorder}" VerticalAlignment="Bottom" />

        <!-- ═══════════════ MODE TAB BAR ═══════════════ -->
        <Grid Grid.Row="1" Margin="16,10,16,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SystemPromptTabButton" Style="{StaticResource TabButton}" Content="System Prompt"
                        Click="SystemPromptTab_Click" />
                <Button x:Name="ToolsTabButton" Style="{StaticResource TabButton}" Content="Tools"
                        Click="ToolsTab_Click" />
                <Button x:Name="AdvancedTabButton" Style="{StaticResource TabButton}" Content="Advanced"
                        Click="AdvancedTab_Click" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource PanelSecondaryBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="10,3">
                <TextBlock x:Name="EnabledPillText" Text="0 / 0 tools enabled" FontSize="10.5"
                           Foreground="{DynamicResource WindowForeground}" />
            </Border>
        </Grid>

        <!-- ═══════════════ MAIN ═══════════════ -->
        <Grid Grid.Row="2" Margin="16,10,16,8">
            <!-- ── TOOLS TAB: master–detail ── -->
            <Grid x:Name="ToolsMainPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: tool list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="AGENT TOOLS" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WindowForeground}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ListCountText" FontSize="11.5" Foreground="{DynamicResource PanelHeaderForeground}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="ToolSearchBox" MinHeight="26" VerticalContentAlignment="Center"
                             Padding="6,3"
                             TextChanged="ToolSearchBox_TextChanged"
                             ToolTip="Search tools, params, categories… (Ctrl+F)" />

                    <Grid Grid.Row="2" Margin="0,8,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilterAllChip" Style="{StaticResource FilterChip}" Content="All"
                                    Tag="all" Click="FilterChip_Click" />
                            <Button x:Name="FilterEnabledChip" Style="{StaticResource FilterChip}" Content="Enabled"
                                    Tag="enabled" Margin="6,0,0,0" Click="FilterChip_Click" />
                            <Button x:Name="FilterOverriddenChip" Style="{StaticResource FilterChip}" Content="Overridden"
                                    Tag="overridden" Margin="6,0,0,0" Click="FilterChip_Click" />
                        </StackPanel>
                        <Button x:Name="SelectAllLink" Style="{StaticResource LinkButton}" Content="Select all"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="SelectAllLink_Click" />
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                            Background="{DynamicResource PanelBackground}">
                        <ScrollViewer x:Name="ToolListScroller" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <StackPanel x:Name="ToolsListPanel" Margin="0,4,0,12" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Right: tool detail -->
                <Grid Grid.Column="2">
                    <controls:ToolDetailView x:Name="ToolDetailHost" />
                    <TextBlock x:Name="NoToolSelectedText" Text="Select a tool on the left to edit it."
                               FontSize="12" Foreground="{DynamicResource ControlDisabledForeground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- ── SYSTEM PROMPT TAB ── -->
            <Grid x:Name="SystemPromptPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="System Prompt" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource WindowForeground}" Margin="2,0,0,6" />
                <TextBox Grid.Row="1" x:Name="SystemPromptBox"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Code, Consolas" FontSize="12"
                         Padding="8"
                         TextChanged="SystemPromptBox_TextChanged" />
            </Grid>

            <!-- ── ADVANCED TAB ── -->
            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="2,0,0,0">
                <TextBlock Text="ADVANCED" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource WindowForeground}" />
                <TextBlock x:Name="AdvancedSummaryText" FontSize="11.5" Foreground="{DynamicResource PanelForeground}"
                           TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource PanelSecondaryBackground}"
                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GitAddedForeground}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource PanelForeground}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="LastSavedText" FontSize="11" Foreground="{DynamicResource ControlDisabledForeground}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
