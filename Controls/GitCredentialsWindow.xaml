<Window x:Class="KaneCode.Controls.GitCredentialsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Git Authentication" Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Remote authentication required" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
 <TextBlock Grid.Row="1" Text="Username:" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="UsernameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="git"/>
 <TextBlock Grid.Row="2" Text="Password / token:" VerticalAlignment="Center" Margin="0,0,8,8"/><PasswordBox x:Name="TokenBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
 <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="For GitHub HTTPS, use a personal access token instead of your account password. The value is kept only in memory." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,14"/>
 <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="85" IsCancel="True" Margin="0,0,8,0"/><Button Content="Continue" Width="85" IsDefault="True" Click="Continue_Click"/></StackPanel>
 </Grid>
</Window>
