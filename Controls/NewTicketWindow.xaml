<Window x:Class="KaneCode.Controls.NewTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Ticket" Width="640" Height="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Create a KaneCode Ticket"
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <TextBlock Grid.Row="1" Text="Title (file name):" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox x:Name="TitleTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Text="Description:" VerticalAlignment="Top" Margin="0,4,8,8" />
        <TextBox x:Name="DescriptionTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="180" />

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="The following fields are optional. Leave them blank to use the IDE's active provider, model, and agent mode."
                   TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource PanelForeground}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Text="Provider:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox x:Name="ProviderComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                  IsEditable="True" />

        <TextBlock Grid.Row="5" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox x:Name="ModelComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                  IsEditable="True" />

        <TextBlock Grid.Row="6" Text="Agent Mode:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox x:Name="AgentModeComboBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                  IsEditable="True" />

        <TextBlock Grid.Row="7" Text="Priority:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox x:Name="PriorityTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Text="0" />

        <TextBlock Grid.Row="8" Text="Start After:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox x:Name="StartAfterTextBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8"
                 ToolTip="Optional title of another ticket that must complete before this one starts." />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Create" Width="90" IsDefault="True" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
