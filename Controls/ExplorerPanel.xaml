<UserControl x:Class="KaneCode.Controls.ExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KaneCode.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── Toolbar button: flat, subtle hover ───────────────── -->
        <Style x:Key="ExplorerToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlSelectionBackground}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ControlSelectionForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern TreeViewItem: chevron, rounded full-width rows ── -->
        <Style x:Key="ExplorerTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Column="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="18" Height="18"
                                          VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Chevron"
                                                  Data="M1.5,0.5 L4.5,3.5 L1.5,6.5"
                                                  Stroke="{DynamicResource ExplorerExpanderForeground}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="7" Height="8" Stretch="Uniform"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotate"
                                                                      Angle="0" CenterX="3" CenterY="3.5" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="90" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Row"
                                    Grid.Column="1"
                                    CornerRadius="4"
                                    Margin="2,0,6,0"
                                    Padding="4,0"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlHoverBackground}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource TreeViewItemSelectedBackground}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TreeViewItemSelectedForeground}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ExplorerItemInactiveSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Toolbar ─────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelSecondaryBackground}"
                BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel>
                <Menu DockPanel.Dock="Left"
                      Background="Transparent"
                      VerticalAlignment="Center">
                    <MenuItem Header="New File" FontSize="12">
                        <MenuItem Header="Blank File..." Click="NewBlankFile_Click" />
                        <Separator />
                        <MenuItem x:Name="NewFileTemplatesMenu"
                                  Header="From Template..."
                                  SubmenuOpened="NewFileTemplates_SubmenuOpened" />
                        <Separator />
                        <MenuItem Header="New Folder" Click="NewFolder_Click" />
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ExplorerToolbarButton}"
                        Content="Refresh"
                        ToolTip="Refresh the explorer tree"
                        Margin="2,0,0,0"
                        Click="Refresh_Click" />
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ExplorerToolbarButton}"
                        Content="Collapse All"
                        ToolTip="Collapse all folders"
                        Click="CollapseAll_Click" />
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ExplorerToolbarButton}"
                        Content="Expand All"
                        ToolTip="Expand all folders"
                        Click="ExpandAll_Click" />

                <Grid DockPanel.Dock="Right"
                      Width="150" Margin="6,0,2,0"
                      VerticalAlignment="Center">
                    <TextBox x:Name="FilterBox"
                             Height="22"
                             Padding="18,0,4,0"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource ControlBackground}"
                             Foreground="{DynamicResource ControlForeground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             BorderThickness="1"
                             ToolTip="Filter the tree by file or folder name"
                             TextChanged="FilterBox_TextChanged" />
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{DynamicResource ControlDisabledForeground}"
                               Margin="6,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="FilterPlaceholder"
                               Text="Filter..."
                               FontSize="11"
                               Foreground="{DynamicResource ControlDisabledForeground}"
                               Margin="18,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ── Tree ────────────────────────────────────────────── -->
        <TreeView x:Name="ExplorerTree"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  Foreground="{DynamicResource PanelForeground}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                  PreviewMouseLeftButtonDown="ExplorerTree_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="ExplorerTree_PreviewMouseMove"
                  PreviewMouseRightButtonDown="ExplorerTree_PreviewMouseRightButtonDown"
                  PreviewKeyDown="ExplorerTree_PreviewKeyDown">

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem"
                       BasedOn="{StaticResource ExplorerTreeViewItemStyle}" />
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type models:ProjectItem}"
                                          ItemsSource="{Binding Children}">
                    <Grid MinHeight="18" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Vector icon -->
                        <Grid Grid.Column="0"
                              Width="16" Height="16"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center">
                            <Path x:Name="IconFolder"
                                  Data="{StaticResource ExplorerIconGeometry.Folder}"
                                  Stroke="{DynamicResource ExplorerFolderIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="IconFile"
                                  Data="{StaticResource ExplorerIconGeometry.File}"
                                  Stroke="{DynamicResource ExplorerFileIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="IconProject"
                                  Data="{StaticResource ExplorerIconGeometry.Project}"
                                  Stroke="{DynamicResource ExplorerProjectIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="IconSolution"
                                  Data="{StaticResource ExplorerIconGeometry.Solution}"
                                  Stroke="{DynamicResource ExplorerSolutionIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="IconDependencies"
                                  Data="{StaticResource ExplorerIconGeometry.Dependencies}"
                                  Stroke="{DynamicResource ExplorerDependenciesIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="IconFramework"
                                  Data="{StaticResource ExplorerIconGeometry.Framework}"
                                  Stroke="{DynamicResource ExplorerFrameworkIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="IconPackage"
                                  Data="{StaticResource ExplorerIconGeometry.Package}"
                                  Stroke="{DynamicResource ExplorerPackageIconForeground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                            <Ellipse x:Name="IconPackageDot"
                                     Width="3" Height="3"
                                     Fill="{DynamicResource ExplorerPackageIconForeground}"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                     Visibility="Collapsed" />
                        </Grid>

                        <TextBlock x:Name="NameText"
                                   Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FullPath}" />

                        <!-- Git status badge -->
                        <Border x:Name="GitBadge"
                                Grid.Column="2"
                                CornerRadius="3"
                                MinWidth="16"
                                Padding="3,0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ExplorerGitBadgeBackground}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="GitBadgeText"
                                       Text="{Binding GitBadgeText}"
                                       FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PanelForeground}" />
                        </Border>
                    </Grid>
                    <HierarchicalDataTemplate.Triggers>
                        <!-- Icon selection by node type -->
                        <DataTrigger Binding="{Binding ItemType}" Value="File">
                            <Setter TargetName="IconFile" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Folder">
                            <Setter TargetName="IconFolder" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Project">
                            <Setter TargetName="IconProject" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Solution">
                            <Setter TargetName="IconSolution" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Dependencies">
                            <Setter TargetName="IconDependencies" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Framework">
                            <Setter TargetName="IconFramework" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Package">
                            <Setter TargetName="IconPackage" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconPackageDot" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!-- File icon tint by extension -->
                        <DataTrigger Binding="{Binding FileExtension}" Value="cs">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerCsFileIconForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileExtension}" Value="xaml">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerConfigFileIconForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileExtension}" Value="xml">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerConfigFileIconForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileExtension}" Value="json">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerConfigFileIconForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileExtension}" Value="config">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerConfigFileIconForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileExtension}" Value="md">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerMarkdownFileIconForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileExtension}" Value="markdown">
                            <Setter TargetName="IconFile" Property="Stroke"
                                    Value="{DynamicResource ExplorerMarkdownFileIconForeground}" />
                        </DataTrigger>

                        <!-- Git badge visibility + color -->
                        <DataTrigger Binding="{Binding GitBadge}" Value="Modified">
                            <Setter TargetName="GitBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GitBadgeText" Property="Foreground"
                                    Value="{DynamicResource GitModifiedForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GitBadge}" Value="Added">
                            <Setter TargetName="GitBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GitBadgeText" Property="Foreground"
                                    Value="{DynamicResource GitAddedForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GitBadge}" Value="Untracked">
                            <Setter TargetName="GitBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GitBadgeText" Property="Foreground"
                                    Value="{DynamicResource GitUntrackedForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GitBadge}" Value="Deleted">
                            <Setter TargetName="GitBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GitBadgeText" Property="Foreground"
                                    Value="{DynamicResource GitDeletedForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GitBadge}" Value="Conflict">
                            <Setter TargetName="GitBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GitBadgeText" Property="Foreground"
                                    Value="{DynamicResource GitConflictForeground}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

            <TreeView.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem x:Name="ContextMenuOpen" Header="_Open" Click="ContextMenu_Open" />
                    <Separator />
                    <MenuItem Header="New _File">
                        <MenuItem Header="Blank File..." Click="ContextMenu_NewBlankFile" />
                        <MenuItem x:Name="ContextNewFileTemplates"
                                  Header="From _Template..."
                                  SubmenuOpened="NewFileTemplates_SubmenuOpened" />
                    </MenuItem>
                    <MenuItem Header="New _Folder" Click="ContextMenu_NewFolder" />
                    <Separator />
                    <MenuItem x:Name="ContextMenuRename" Header="_Rename (F2)" Click="ContextMenu_Rename" />
                    <MenuItem x:Name="ContextMenuDelete" Header="_Delete (Del)" Click="ContextMenu_Delete" />
                    <Separator />
                    <MenuItem x:Name="ContextMenuCopyPath" Header="Copy _Path" Click="ContextMenu_CopyPath" />
                    <MenuItem x:Name="ContextMenuReveal"
                              Header="_Reveal in File Explorer"
                              Click="ContextMenu_RevealInExplorer" />
                    <Separator />
                    <MenuItem Header="Select _All (Ctrl+A)" Click="ContextMenu_SelectAll" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>

        <!-- ── Status bar ──────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelSecondaryBackground}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <TextBlock x:Name="StatusText"
                       Text="No items"
                       FontSize="11"
                       Foreground="{DynamicResource PanelHeaderForeground}" />
        </Border>
    </Grid>
</UserControl>
