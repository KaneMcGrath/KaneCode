<Window x:Class="KaneCode.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="clr-namespace:KaneCode.Models"
xmlns:controls="clr-namespace:KaneCode.Controls"
xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
mc:Ignorable="d"
Title="{Binding WindowTitle}" Height="450" Width="800" WindowState="Maximized"
SnapsToDevicePixels="True"
Foreground="{DynamicResource WindowForeground}"
Background="{DynamicResource HeaderBackground}"
Icon="Icons/KaneCode.ico"
WindowStyle="None"
ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" CornerRadius="0"
                      GlassFrameThickness="0" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsActive" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource WindowInactiveBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="23" />
        </Grid.RowDefinitions>

        <!-- Title bar area -->
        <Grid Grid.Row="0">
            <StackPanel Margin="8,4" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Menu bar -->
                <Menu x:Name="MainMenu" Style="{DynamicResource MetroMenu}" VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewFileCommand}" />
                <MenuItem Header="New _Project..." Click="FileMenu_NewProject_Click" />
                <MenuItem Header="_Clone Repository..." Click="FileMenu_CloneRepository_Click" />
                <MenuItem Header="_Open File" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open _Folder" Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="Open _Project or Solution..." Command="{Binding OpenProjectOrSolutionCommand}" />
                <Separator />
                <MenuItem Header="_Recent Projects"
                          ItemsSource="{Binding RecentProjects}"
                          DisplayMemberPath="DisplayName">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="_Remove from Recent"
                                                  Command="{Binding DataContext.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Clear Recent Projects"
                          Command="{Binding ClearRecentProjectsCommand}"
                          Foreground="{DynamicResource MenuForeground}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Go to _Definition" Command="{Binding GoToDefinitionCommand}" />
                <MenuItem Header="Find _References" Command="{Binding FindReferencesCommand}" />
                <MenuItem Header="Go To _Symbol..." Command="{Binding GoToSymbolCommand}" />
                <MenuItem Header="Code _Actions" Command="{Binding CodeActionsCommand}" />
                <MenuItem Header="_Rename" Command="{Binding RenameCommand}" />
                <MenuItem Header="_Extract Method" Command="{Binding ExtractMethodCommand}" />
                <Separator />
                <MenuItem Header="NuGet Package _Manager..." Click="EditMenu_NuGetPackageManager_Click" />
                <Separator />
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Explorer"
                          Tag="{Binding ElementName=ExplorerAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="_Error List"
                          Tag="{Binding ElementName=ErrorListAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="B_uild Output"
                          Tag="{Binding ElementName=BuildOutputAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="Fi_nd References"
                          Tag="{Binding ElementName=FindReferencesAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="_Git Changes"
                          Tag="{Binding ElementName=GitChangesAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="Git _Log"
                          Tag="{Binding ElementName=GitLogAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="_AI Chat"
                          Tag="{Binding ElementName=AiChatAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="_Agent Orchestrator"
                          Tag="{Binding ElementName=AgentOrchestratorAnchorable}"
                          Click="ViewMenuPanel_Click" />
                 <MenuItem Header="AI _Debug"
                           Tag="{Binding ElementName=AiDebugAnchorable}"
                           Click="ViewMenuPanel_Click" />
                <Separator />
                <MenuItem Header="_Options" Command="{Binding OpenOptionsCommand}" />
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="_Build Target"
                          ItemsSource="{Binding BuildTargets}"
                          ToolTip="Select the project or solution to build">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding DataContext.SelectBuildTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding BuildSelectedText}" Command="{Binding BuildCommand}" />
                <MenuItem Header="{Binding RunCommandText}" Command="{Binding RunCommand}" />
                <Separator />
                <MenuItem Header="_Cancel" Command="{Binding CancelBuildCommand}" />
                <Separator />
                <MenuItem Header="Customize _Launch Settings..." Click="BuildMenu_CustomizeLaunchSettings_Click" />
            </MenuItem>
            <MenuItem Header="_Git">
                <MenuItem Header="_Refresh Status" Command="{Binding RefreshGitStatusCommand}" />
                <MenuItem Header="_Fetch" Command="{Binding FetchCommand}" />
                <MenuItem Header="_Pull" Command="{Binding PullCommand}" />
                <MenuItem Header="P_ush" Command="{Binding PushCommand}" />
                <Separator />
                <MenuItem Header="_Commit..." Command="{Binding CommitCommand}" />
                <MenuItem Header="_Create Branch..." Command="{Binding CreateBranchCommand}" />
                <MenuItem Header="_Delete Branch..." Command="{Binding DeleteBranchCommand}" />
                <MenuItem Header="_Git Changes"
                          Tag="{Binding ElementName=GitChangesAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <MenuItem Header="Git _Log"
                          Tag="{Binding ElementName=GitLogAnchorable}"
                          Click="ViewMenuPanel_Click" />
                <Separator />
                <MenuItem Header="_Initialize Repository"
                          Command="{Binding InitializeGitRepositoryCommand}" />
                <Separator />
                <MenuItem Header="{Binding GitRepositoryStatusText}"
                          IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open _Config Folder"
                          Click="HelpMenu_OpenConfigFolder_Click"
                          ToolTip="Opens the folder where KaneCode stores its settings and config files." />
                <Separator />
                <MenuItem Header="_About" />
            </MenuItem>
            <!-- Quick Build and Run Buttons (Right side) -->
            <MenuItem>
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding DataContext.AvailableConfigurations, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.SelectedConfiguration, RelativeSource={RelativeSource AncestorType=Window}}"
                                  MinWidth="80"
                                  Height="22"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource ControlBackground}"
                                  Foreground="{DynamicResource MenuForeground}"
                                  BorderBrush="{DynamicResource ControlBorder}"
                                  BorderThickness="1"
                                  Padding="4,1"
                                  ToolTip="Select build configuration (Debug or Release)" />
                        <Button Content="🔨" Padding="6,2" Margin="4,0,0,0"
                                Background="Transparent"
                                Foreground="{DynamicResource MenuForeground}"
                                BorderThickness="0"
                                Command="{Binding DataContext.BuildCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Build selected target" />
                        <!-- Run button: split button with integrated launch-profile dropdown -->
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource MenuForeground}"
                                    BorderThickness="0"
                                    Padding="6,2,3,2"
                                    ToolTip="{Binding DataContext.RunCommandToolTip, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DataContext.RunQuickButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Text="{Binding DataContext.RunProfileDisplayText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Margin="5,0,0,0"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RunProfileDropdownButton" Content="▾" Padding="3,2"
                                    Background="Transparent" Foreground="{DynamicResource MenuForeground}" BorderThickness="0"
                                    Click="RunProfileDropdown_Click"
                                    ToolTip="Select launch profile" />
                        </StackPanel>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

                <!-- Title text -->
                <Border Background="{DynamicResource ProjectNameBackground}" Padding="8,0" Margin="14,0">
                    <TextBlock Text="{Binding WindowTitle}" VerticalAlignment="Center" Padding="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ProjectNameForeground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource ProjectNameInactiveForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Window chrome buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Theme selector (kept left of the system buttons) -->
                <ComboBox x:Name="ThemeSelector"
                          Margin="0,0,12,0"
                          MinWidth="80"
                          VerticalAlignment="Center"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="OnThemeSelectionChanged" />
                <Button Style="{StaticResource MinimizeButton}" Click="OnMinimizeClick" />
                <Button Style="{StaticResource MaximizeButton}" Click="OnMaximizeClick" />
                <Button Style="{StaticResource RestoreDownButton}" Click="OnRestoreDownClick" />
                <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- AvalonDock DockingManager -->
        <avalonDock:DockingManager x:Name="DockManager" Grid.Row="1">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <!-- Left: Explorer panel -->
                    <!-- Default to ~1/6 of the window width -->
                    <avalonDock:LayoutAnchorablePane DockWidth="1*">
                        <avalonDock:LayoutAnchorable x:Name="ExplorerAnchorable" Title="Explorer"
                                                     CanClose="False"
                                                     CanHide="True"
                                                     CanAutoHide="True"
                                                     ContentId="ExplorerPane">
                            <Border Background="{DynamicResource PanelBackground}">
                                <controls:ExplorerPanel x:Name="ExplorerPanelControl"
                                                        ItemsSource="{Binding ProjectItems}"
                                                        ExplorerActionRequested="ExplorerPanel_ActionRequested" />
                            </Border>
                        </avalonDock:LayoutAnchorable>
                        <avalonDock:LayoutAnchorable x:Name="GitChangesAnchorable" Title="Git Changes"
                                                     CanClose="False"
                                                     CanHide="True"
                                                     CanAutoHide="True"
                                                     ContentId="GitChangesPane">
                            <controls:GitChangesPanel x:Name="GitChangesPanel"
                                                      UnstagedChanges="{Binding UnstagedChanges}"
                                                      StagedChanges="{Binding StagedChanges}"
                                                      GitBranches="{Binding GitBranches}"
                                                      SelectedGitBranch="{Binding SelectedGitBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      PanelStatusText="{Binding GitChangesStatusText}"
                                                      IsRepositoryOpen="{Binding IsGitRepositoryOpen}"
                                                      RefreshRequested="GitChangesPanel_RefreshRequested"
                                                      FileOpenRequested="GitChangesPanel_FileOpenRequested" />
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <!-- Center: Document + Error List (vertical split) -->
                    <!-- Default to ~5/6 of the window width -->
                    <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="5*">

                        <!-- Editor panel -->
                        <!-- Default to ~5/6 of the right-side height -->
                        <avalonDock:LayoutAnchorablePane DockHeight="5*">
                            <avalonDock:LayoutAnchorable x:Name="EditorAnchorable" Title="Editor"
                                                         CanClose="False"
                                                         CanHide="False"
                                                         CanAutoHide="False"
                                                         ContentId="EditorPane">
                                <DockPanel>
                                    <!-- Tab strip with drag-drop reordering -->
                                    <TabControl x:Name="EditorTabControl"
                                                DockPanel.Dock="Top"
                                                ItemsSource="{Binding EditorTabs}"
                                                SelectionChanged="TabControl_SelectionChanged"
                                                Background="{DynamicResource TabStripBackground}"
                                                BorderThickness="0"
                                                Height="28"
                                                Style="{DynamicResource NoOffsetAndNoContentTabControl}"
                                                AllowDrop="True"
                                                PreviewDrop="TabStrip_Drop"
                                                PreviewDragOver="TabStrip_PreviewDragOver">

                                        <TabControl.Resources>
                                            <DataTemplate DataType="{x:Type models:OpenFileTab}">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="_Close" Click="TabContextMenu_Close" />
                                                            <MenuItem Header="Close _Others" Click="TabContextMenu_CloseOthers" />
                                                            <MenuItem Header="Close _All" Click="TabContextMenu_CloseAll" />
                                                            <Separator />
                                                            <MenuItem Header="Copy _Path" Click="TabContextMenu_CopyPath" />
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                                    <TextBlock Text="{Binding DisplayName}" Margin="8,2,4,2" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="✕" FontSize="10" Padding="2,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TabCloseButtonForeground}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.CloseTabCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type models:GitDiffTab}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" Margin="8,2,4,2" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="✕" FontSize="10" Padding="2,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TabCloseButtonForeground}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Click="DiffTab_Close" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TabControl.Resources>

                                        <TabControl.ItemContainerStyle>
                                            <Style TargetType="TabItem" BasedOn="{StaticResource NoOffsetTabItem}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource TabForeground}" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="AllowDrop" Value="True" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
                                                <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove" />
                                            </Style>
                                        </TabControl.ItemContainerStyle>
                                    </TabControl>

                                    <controls:CodeActionLightBulb x:Name="CodeActionPopup"
                                                                  DockPanel.Dock="Top"
                                                                  ActionSelected="CodeActionLightBulb_ActionSelected" />

                                    <!-- Editor + Presentation Overlay + Markdown Preview -->
                                    <DockPanel>
                                        <!-- Markdown toolbar (only visible for .md files) -->
                                        <Border x:Name="MarkdownToolbar"
                                                DockPanel.Dock="Bottom"
                                                Visibility="Collapsed"
                                                Height="28"
                                                Background="{DynamicResource StatusBarBackground}">
                                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                                <ToggleButton x:Name="MarkdownEditButton"
                                                              Content="Edit"
                                                              IsChecked="True"
                                                              Width="80"
                                                              Height="22"
                                                              FontSize="11"
                                                              Cursor="Hand"
                                                              Foreground="{DynamicResource StatusBarForeground}"
                                                              Background="{DynamicResource ControlBackground}"
                                                              BorderBrush="{DynamicResource ControlBorder}"
                                                              BorderThickness="1"
                                                              Padding="6,1"
                                                              Checked="MarkdownViewToggle_Checked"
                                                              Unchecked="MarkdownViewToggle_Unchecked" />
                                                <ToggleButton x:Name="MarkdownPreviewButton"
                                                              Content="Preview"
                                                              IsChecked="False"
                                                              Width="80"
                                                              Height="22"
                                                              FontSize="11"
                                                              Margin="6,0,0,0"
                                                              Cursor="Hand"
                                                              Foreground="{DynamicResource StatusBarForeground}"
                                                              Background="{DynamicResource ControlBackground}"
                                                              BorderBrush="{DynamicResource ControlBorder}"
                                                              BorderThickness="1"
                                                              Padding="6,1"
                                                              Checked="MarkdownViewToggle_Checked"
                                                              Unchecked="MarkdownViewToggle_Unchecked" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Image toolbar (only visible for image files) -->
                                        <Border x:Name="ImageToolbar"
                                                DockPanel.Dock="Bottom"
                                                Visibility="Collapsed"
                                                Height="28"
                                                Background="{DynamicResource StatusBarBackground}">
                                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                                <ToggleButton x:Name="ImageEditButton"
                                                              Content="Edit"
                                                              IsChecked="True"
                                                              Width="80"
                                                              Height="22"
                                                              FontSize="11"
                                                              Cursor="Hand"
                                                              Foreground="{DynamicResource StatusBarForeground}"
                                                              Background="{DynamicResource ControlBackground}"
                                                              BorderBrush="{DynamicResource ControlBorder}"
                                                              BorderThickness="1"
                                                              Padding="6,1"
                                                              Checked="ImageViewToggle_Checked"
                                                              Unchecked="ImageViewToggle_Unchecked" />
                                                <ToggleButton x:Name="ImagePreviewButton"
                                                              Content="Preview"
                                                              IsChecked="False"
                                                              Width="80"
                                                              Height="22"
                                                              FontSize="11"
                                                              Margin="6,0,0,0"
                                                              Cursor="Hand"
                                                              Foreground="{DynamicResource StatusBarForeground}"
                                                              Background="{DynamicResource ControlBackground}"
                                                              BorderBrush="{DynamicResource ControlBorder}"
                                                              BorderThickness="1"
                                                              Padding="6,1"
                                                              Checked="ImageViewToggle_Checked"
                                                              Unchecked="ImageViewToggle_Unchecked" />
                                            </StackPanel>
                                        </Border>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <avalonEdit:TextEditor x:Name="CodeEditor"
                                                               Grid.Row="0"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               FontSize="14"
                                                               ShowLineNumbers="True"
                                                               LineNumbersForeground="{DynamicResource EditorLineNumbersForeground}"
                                                               Background="{DynamicResource EditorBackground}"
                                                               Foreground="{DynamicResource EditorForeground}"
                                                               HorizontalScrollBarVisibility="Auto"
                                                               VerticalScrollBarVisibility="Auto">
                                                <avalonEdit:TextEditor.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Cu_t" Click="EditorContextMenu_Cut"
                                                                  InputGestureText="Ctrl+X" />
                                                        <MenuItem Header="_Copy" Click="EditorContextMenu_Copy"
                                                                  InputGestureText="Ctrl+C" />
                                                        <MenuItem Header="_Paste" Click="EditorContextMenu_Paste"
                                                                  InputGestureText="Ctrl+V" />
                                                        <Separator />
                                                        <MenuItem Header="_Undo" Click="EditorContextMenu_Undo"
                                                                  InputGestureText="Ctrl+Z" />
                                                        <MenuItem Header="_Redo" Click="EditorContextMenu_Redo"
                                                                  InputGestureText="Ctrl+Y" />
                                                        <Separator />
                                                        <MenuItem Header="Go to _Definition" Click="EditorContextMenu_GoToDefinition"
                                                                  InputGestureText="F12" />
                                                        <MenuItem Header="Find _References" Click="EditorContextMenu_FindReferences"
                                                                  InputGestureText="Shift+F12" />
                                                        <MenuItem Header="Code _Actions" Click="EditorContextMenu_CodeActions"
                                                                  InputGestureText="Ctrl+." />
                                                        <MenuItem Header="_Rename" Click="EditorContextMenu_Rename"
                                                                  InputGestureText="F2" />
                                                        <MenuItem Header="_Extract Method" Click="EditorContextMenu_ExtractMethod"
                                                                  InputGestureText="Ctrl+Shift+M" />
                                                        <Separator />
                                                        <MenuItem Header="Ask AI About _Selection" Click="EditorContextMenu_AskAboutSelection" />
                                                    </ContextMenu>
                                                </avalonEdit:TextEditor.ContextMenu>
                                            </avalonEdit:TextEditor>
                                            <controls:MarkdownPreviewPanel x:Name="MarkdownPreview" Grid.Row="0" Visibility="Collapsed" />
                                            <controls:ImagePreviewPanel x:Name="ImagePreview" Grid.Row="0" Visibility="Collapsed" />
                                            <controls:PresentationOverlay x:Name="PresentationOverlay" Grid.Row="0" />
                                            <controls:GitDiffPanel x:Name="GitDiffPanel" Grid.Row="0" Visibility="Collapsed" />

                                            <!-- Editor info bar (more indicators will be added here later) -->
                                            <Border x:Name="EditorInfoBar"
                                                    Grid.Row="1"
                                                    Height="22"
                                                    Background="{DynamicResource StatusBarBackground}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0">
                                                        <TextBlock Text="Font size:"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource StatusBarForeground}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox x:Name="EditorFontSizeBox"
                                                                 Width="42"
                                                                 Height="16"
                                                                 Margin="4,0,0,0"
                                                                 FontSize="11"
                                                                 Padding="2,0"
                                                                 TextAlignment="Right"
                                                                 VerticalContentAlignment="Center"
                                                                 CaretBrush="{DynamicResource StatusBarForeground}"
                                                                 Foreground="{DynamicResource StatusBarForeground}"
                                                                 Background="{DynamicResource ControlBackground}"
                                                                 BorderBrush="{DynamicResource ControlBorder}"
                                                                 BorderThickness="1"
                                                                 ToolTip="Editor font size. Type a value and press Enter, or hold Ctrl and scroll to zoom."
                                                                 KeyDown="EditorFontSizeBox_KeyDown"
                                                                 LostFocus="EditorFontSizeBox_LostFocus" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </DockPanel>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!-- Bottom: Error List and Build Output panels -->
                        <!-- Default to ~1/6 of the right-side height -->
                        <avalonDock:LayoutAnchorablePane DockHeight="1*">
                            <avalonDock:LayoutAnchorable x:Name="ErrorListAnchorable" Title="Error List"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         CanAutoHide="True"
                                                         ContentId="ErrorListPane">
                                <controls:ErrorListPanel x:Name="ErrorList"
                                                         Diagnostics="{Binding DiagnosticItems}"
                                                         NavigateRequested="ErrorList_NavigateRequested"
                                                         FixRequested="ErrorList_FixRequested" />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="BuildOutputAnchorable" Title="Build Output"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         CanAutoHide="True"
                                                         ContentId="BuildOutputPane">
                                <controls:BuildOutputPanel x:Name="BuildOutput"
                                                           OutputEvents="{Binding BuildOutputEvents}"
                                                           BuildSummary="{Binding BuildSummary}" />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="FindReferencesAnchorable" Title="Find References"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         CanAutoHide="True"
                                                         ContentId="FindReferencesPane">
                                <controls:FindReferencesPanel x:Name="FindReferencesPanel"
                                                              References="{Binding ReferenceItems}"
                                                              PanelStatusText="{Binding FindReferencesStatusText}"
                                                              PeekHeaderText="{Binding ReferencePeekHeaderText}"
                                                              PeekContentText="{Binding ReferencePeekContentText}"
                                                              PreviewRequested="FindReferencesPanel_PreviewRequested"
                                                              NavigateRequested="FindReferencesPanel_NavigateRequested" />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="GitLogAnchorable" Title="Git Log"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         CanAutoHide="True"
                                                         ContentId="GitLogPane">
                                <controls:GitLogPanel x:Name="GitLogPanel"
                                                      Commits="{Binding GitCommitHistory}"
                                                      PanelStatusText="{Binding GitLogStatusText}" />
                            </avalonDock:LayoutAnchorable>
                             <avalonDock:LayoutAnchorable x:Name="AiDebugAnchorable" Title="AI Debug"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          CanAutoHide="True"
                                                          ContentId="AiDebugPane">
                                 <controls:AiDebugPanel x:Name="AiDebugPanel" />
                             </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                    </avalonDock:LayoutPanel>

                    <avalonDock:LayoutAnchorablePane DockWidth="1.5*">
                        <avalonDock:LayoutAnchorable x:Name="AgentOrchestratorAnchorable" Title="Agent Orchestrator"
                                                     CanClose="False"
                                                     CanHide="True"
                                                     CanAutoHide="True"
                                                     ContentId="AgentOrchestratorPane">
                            <controls:AgentOrchestratorPanel x:Name="AgentOrchestratorPanel" />
                        </avalonDock:LayoutAnchorable>
                        <avalonDock:LayoutAnchorable x:Name="AiChatAnchorable" Title="AI Chat"
                                                     CanClose="False"
                                                     CanHide="True"
                                                     CanAutoHide="True"
                                                     ContentId="AiChatPane">
                            <controls:AiChatPanel x:Name="AiChatPanel" />
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackground}">
            <TextBlock Text="{Binding StatusText}" Margin="8,2"
                       Foreground="{DynamicResource StatusBarForeground}"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</Window>
